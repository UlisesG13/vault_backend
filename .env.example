# Copia este archivo a .env y rellena los valores reales.

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Usa la service_role key (el backend confía en el servidor, no expone esta clave)
SUPABASE_KEY=eyJhbGciOi...service_role...

# --- Cifrado de contraseñas de las cuentas gestionadas (Fernet) ---
# Genera una con:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=cambia_esto_por_una_clave_fernet_de_32_bytes_base64

# --- JWT (autenticación de los usuarios del sistema) ---
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Orígenes permitidos separados por coma (ej: https://miapp.com,https://admin.miapp.com)
# El frontend Vite corre en :5173. "*" solo para desarrollo.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
